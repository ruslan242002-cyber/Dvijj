'use strict';
/**
* ОБЛОМКИ ПОГИБШИХ — по духу похоже на lib/ambush-registry.js (снимок
* игрока на момент события), но это НЕ PvP-атака — это то, что остаётся
* ПОСЛЕ поражения в бою с монстром в красной зоне: часть груза
* (tripCargo, ещё не сданного в трюм) высыпается в космос и может быть
* найдена другим игроком, а не просто исчезает.
*
* Общий мир — обломки не принадлежат погибшему игроку в памяти
* вызывающего кода прямо сейчас (владелец мог быть оффлайн уже), поэтому
* хранение — атомарные Redis-ключи, тот же паттерн, что market/guild.
* Обломки живут ограниченное время (TTL), потом исчезают сами — иначе
* красная зона зарастала бы вечными кучами лута.
*/
const WRECKAGE_TTL_SEC = 3600; // час реального времени — достаточно, чтобы кто-то успел долететь
function makeWreckageStore(redis) {
return {
/** Создаёт обломки на конкретной дистанции конкретной зоны — cargo это
* снимок tripCargo погибшего (тот груз и правда пропадает у него). */
async dropWreckage(zone, distance, cargo, victimName) {
if (!cargo || !cargo.length) return null;
const id = `wreck_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
const key = `wreckage:${zone}:${distance}`;
const payload = JSON.stringify({ id, cargo, victimName, droppedAt: Date.now() });
await redis.set(key, payload, { ex: WRECKAGE_TTL_SEC });
return id;
},
/** Проверяет, есть ли обломки прямо на текущей дистанции игрока —
* вызывать в момент высадки/прибытия на эту дистанцию. */
async checkWreckage(zone, distance) {
const key = `wreckage:${zone}:${distance}`;
const raw = await redis.get(key);
return raw ? JSON.parse(raw) : null;
},
/** Забирает обломки — атомарно удаляет ключ, чтобы два игрока не
* растащили один и тот же груз по отдельности (первый успевший GETDEL
* получает всё, второй увидит уже пустое место). */
async claimWreckage(zone, distance) {
const key = `wreckage:${zone}:${distance}`;
const raw = await redis.getdel(key);
return raw ? JSON.parse(raw) : null;
},
};
}
/** Вызывать при поражении игрока в красной зоне (не в жёлтой/синей —
* обломки только в открытом космосе, по духу "риск глубоких вылазок"). */
function shouldDropWreckage(zone, player) {
return zone === 'red' && (player.tripCargo || []).length > 0;
}
module.exports = { makeWreckageStore, shouldDropWreckage, WRECKAGE_TTL_SEC };
